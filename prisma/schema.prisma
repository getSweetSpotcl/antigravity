generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserRole {
  SUPER_ADMIN
  BROKERAGE_ADMIN
  AGENT
}

enum PolicyType {
  GENERAL
  LIFE
  HEALTH
  AUTO
  HOME
  GUARANTEE
}

enum ClaimStatus {
  REPORTED
  IN_PROCESS
  APPROVED
  REJECTED
  CLOSED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

// Models

model Tenant {
  id          String   @id @default(cuid())
  name        String
  rut         String   @unique // Chilean Tax ID for the brokerage
  slug        String   @unique // For URL routing potentially
  logoUrl     String?
  
  // Configuración de Suscripción
  plan              String    @default("FREE") // Legacy field, keep for now
  planId            String?
  assignedPlan      Plan?     @relation(fields: [planId], references: [id])
  
  // Configuración de Facturación
  customPrice       Int?      // Precio personalizado (sobrescribe el del plan)
  discountType      String?   // "PERCENTAGE" o "FIXED"
  discountValue     Int?      // Valor del descuento
  billingDay        Int       @default(1) // Día del mes para facturación (1-28)
  nextBillingDate   DateTime? // Próxima fecha de facturación programada

  subscriptionStatus String   @default("TRIAL") // TRIAL, ACTIVE, PAST_DUE, CANCELED, SUSPENDED
  
  // Límites (Estos pueden sobreescribir los del plan)
  maxUsers          Int       @default(5)
  maxStorage        BigInt    @default(1073741824) // 1GB en bytes
  
  // Facturación
  billingEmail      String?
  billingAddress    String?
  billingRecords    BillingRecord[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  clients     Client[]
  policies    Policy[]
  claims      Claim[]
  quotes      Quote[]
  insuranceCompanies InsuranceCompany[]
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // For credentials auth
  role          UserRole  @default(AGENT)
  
  tenantId      String?
  tenant        Tenant?   @relation(fields: [tenantId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tenantId])
}

model Client {
  id          String   @id @default(cuid())
  rut         String   // Chilean ID
  firstName   String
  lastName    String
  email       String?
  phone       String?
  address     String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  policies    Policy[]
  quotes      Quote[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, rut]) // Unique client per brokerage
  @@index([tenantId])
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
}

enum EndorsementType {
  GENERAL_MODIFICATION
  RENEWAL
  CANCELLATION
  INCLUSION
  EXCLUSION
}

model Policy {
  id            String     @id @default(cuid())
  number        String
  company       String     // Insurance Company Name (legacy)
  companyId     String?
  insuranceCompany InsuranceCompany? @relation(fields: [companyId], references: [id])
  type          PolicyType
  status        PolicyStatus @default(ACTIVE)
  
  startDate     DateTime
  endDate       DateTime
  
  premium       Decimal    @db.Decimal(10, 2)
  commission    Decimal    @db.Decimal(10, 2)
  currency      String     @default("UF") // UF, CLP, USD
  
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id])
  
  tenantId      String
  tenant        Tenant     @relation(fields: [tenantId], references: [id])
  
  claims        Claim[]
  endorsements  Endorsement[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([tenantId])
  @@index([clientId])
}

model Endorsement {
  id          String   @id @default(cuid())
  number      String?
  type        EndorsementType @default(GENERAL_MODIFICATION)
  description String
  date        DateTime
  
  policyId    String
  policy      Policy   @relation(fields: [policyId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Claim {
  id          String      @id @default(cuid())
  number      String?
  description String
  status      ClaimStatus @default(REPORTED)
  date        DateTime
  
  policyId    String
  policy      Policy      @relation(fields: [policyId], references: [id])
  
  tenantId    String
  tenant      Tenant      @relation(fields: [tenantId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([tenantId])
  @@index([policyId])
}

model InsuranceCompany {
  id          String   @id @default(cuid())
  name        String
  rut         String?
  contact     String?
  email       String?
  phone       String?
  
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  
  quotes      Quote[]
  policies    Policy[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String?     // Número de cotización
  
  // Partes involucradas
  prospectName    String?     // Si no es cliente aún
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id])
  
  // Tomador (puede ser diferente del asegurado)
  contractorName  String?
  contractorRut   String?
  contractorEmail String?
  contractorPhone String?
  
  // Asegurado (titular del interés asegurable)
  insuredName     String?
  insuredRut      String?
  insuredAddress  String?
  
  // Beneficiario
  beneficiaryName String?
  beneficiaryRut  String?
  beneficiaryType String?     // "Asegurado", "Banco", "Tercero"
  
  // Información de la póliza
  companyId       String?
  company         InsuranceCompany? @relation(fields: [companyId], references: [id])
  policyType      PolicyType
  
  // Detalles del bien asegurado (JSON flexible)
  insuredProperty Json?       // Dirección, tipo, construcción, uso, etc.
  
  // Coberturas y montos
  coverages       Json         // Array de coberturas con detalles
  totalInsuredAmount Decimal?  @db.Decimal(12, 2)
  totalPremium    Decimal      @db.Decimal(10, 2)
  currency        String       @default("UF")
  
  // Deducibles
  deductibles     Json?        // Deducibles por cobertura
  
  // Vigencia
  validFrom       DateTime?
  validUntil      DateTime
  policyDuration  Int?         // Meses
  
  // Estado y notas
  status          QuoteStatus  @default(DRAFT)
  notes           String?      @db.Text
  internalNotes   String?      @db.Text
  
  // Archivos adjuntos
  attachments     QuoteAttachment[]
  
  // Comunicaciones
  communications  QuoteCommunication[]
  
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenantId])
  @@index([clientId])
  @@index([companyId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  fileName    String
  fileUrl     String
  fileType    String   // "image", "pdf", "document", "email"
  fileSize    Int?     // bytes
  description String?
  
  createdAt   DateTime @default(now())
  
  @@index([quoteId])
}

model QuoteCommunication {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  
  type        String   // "call", "email", "meeting", "note"
  subject     String?
  content     String   @db.Text
  contactPerson String?
  
  createdAt   DateTime @default(now())
  
  @@index([quoteId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Int      @default(0) // Precio en CLP
  currency    String   @default("CLP")
  
  // Límites del plan
  maxUsers    Int      @default(5)
  maxStorage  BigInt   @default(1073741824) // 1GB
  
  isActive    Boolean  @default(true)
  
  tenants     Tenant[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BillingRecord {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  amount      Int
  currency    String   @default("CLP")
  status      String   @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  
  issueDate   DateTime @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  
  description String?
  invoiceUrl  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
