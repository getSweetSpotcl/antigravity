generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id            String      @id @default(cuid())
  tenantId      String
  userId        String?
  userName      String?
  userEmail     String?
  userRole      String?
  action        AuditAction
  entity        String
  entityId      String?
  entityName    String?
  description   String?
  oldValues     Json?
  newValues     Json?
  ipAddress     String?
  userAgent     String?
  requestPath   String?
  requestMethod String?
  metadata      Json?
  createdAt     DateTime    @default(now())
  Tenant        Tenant      @relation(fields: [tenantId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@index([tenantId])
  @@index([userId])
}

model BillingRecord {
  id          String    @id @default(cuid())
  tenantId    String
  amount      Int
  currency    String    @default("CLP")
  status      String    @default("PENDING")
  issueDate   DateTime  @default(now())
  dueDate     DateTime
  paidAt      DateTime?
  description String?
  invoiceUrl  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  Tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Claim {
  id                    String            @id @default(cuid())
  number                String?
  description           String
  status                ClaimStatus       @default(REPORTED)
  date                  DateTime
  policyId              String
  tenantId              String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  adjusterCompany       String?
  adjusterEmail         String?
  adjusterName          String?
  adjusterPhone         String?
  adjustmentDate        DateTime?
  approvedAmount        Decimal?          @db.Decimal(12, 2)
  claimAmount           Decimal?          @db.Decimal(12, 2)
  currency              String            @default("UF")
  internalNotes         String?
  paidAmount            Decimal?          @db.Decimal(12, 2)
  reportedToCompanyDate DateTime?
  reserveAmount         Decimal?          @db.Decimal(12, 2)
  resolutionDate        DateTime?
  Policy                Policy            @relation(fields: [policyId], references: [id])
  Tenant                Tenant            @relation(fields: [tenantId], references: [id])
  ClaimAttachment       ClaimAttachment[]
  ClaimHistory          ClaimHistory[]

  @@index([policyId])
  @@index([status])
  @@index([tenantId])
}

model ClaimAttachment {
  id          String   @id @default(cuid())
  claimId     String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int?
  description String?
  createdAt   DateTime @default(now())
  Claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model ClaimHistory {
  id          String   @id @default(cuid())
  claimId     String
  action      String
  description String
  oldValue    String?
  newValue    String?
  userId      String?
  userName    String?
  createdAt   DateTime @default(now())
  Claim       Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
}

model Client {
  id         String       @id @default(cuid())
  rut        String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  address    String?
  tenantId   String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  Tenant     Tenant       @relation(fields: [tenantId], references: [id])
  ClientUser ClientUser[]
  Policy     Policy[]
  Quote      Quote[]

  @@unique([tenantId, rut])
  @@index([tenantId])
}

model ClientUser {
  id                 String              @id @default(cuid())
  clientId           String
  email              String              @unique
  password           String
  rut                String?             // RUT del cliente para acceso multi-corredor
  emailVerified      DateTime?
  isActive           Boolean             @default(true)
  lastLogin          DateTime?
  resetToken         String?             @unique
  resetTokenExpires  DateTime?
  verifyToken        String?             @unique
  verifyTokenExpires DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  Client             Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  DocumentSignature  DocumentSignature[]
  PortalMessage      PortalMessage[]

  @@index([clientId])
  @@index([email])
  @@index([rut])
}

model Commission {
  id                String              @id @default(cuid())
  policyId          String
  percentage        Decimal             @db.Decimal(5, 2)
  baseAmount        Decimal             @db.Decimal(12, 2)
  amount            Decimal             @db.Decimal(12, 2)
  currency          String              @default("UF")
  status            CommissionStatus    @default(PENDING)
  paidAmount        Decimal             @default(0) @db.Decimal(12, 2)
  pendingAmount     Decimal             @db.Decimal(12, 2)
  dueDate           DateTime?
  paidDate          DateTime?
  periodStart       DateTime?
  periodEnd         DateTime?
  installment       Int?
  totalInstallments Int?
  notes             String?
  tenantId          String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  Policy            Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  CommissionPayment CommissionPayment[]
  AgentCommission   AgentCommission[]

  @@index([dueDate])
  @@index([policyId])
  @@index([status])
  @@index([tenantId])
}

model CommissionPayment {
  id             String        @id @default(cuid())
  commissionId   String
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("UF")
  paymentDate    DateTime
  paymentMethod  PaymentMethod
  reference      String?
  bankName       String?
  accountNumber  String?
  receiptUrl     String?
  notes          String?
  recordedBy     String?
  recordedByName String?
  createdAt      DateTime      @default(now())
  Commission     Commission    @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@index([commissionId])
  @@index([paymentDate])
}

model AgentCommission {
  id                     String                   @id @default(cuid())
  commissionId           String
  policyId               String
  agentId                String
  percentage             Decimal                  @db.Decimal(5, 2)
  baseAmount             Decimal                  @db.Decimal(12, 2)
  amount                 Decimal                  @db.Decimal(12, 2)
  currency               String                   @default("UF")
  status                 CommissionStatus         @default(PENDING)
  paidAmount             Decimal                  @default(0) @db.Decimal(12, 2)
  pendingAmount          Decimal                  @db.Decimal(12, 2)
  dueDate                DateTime?
  paidDate               DateTime?
  notes                  String?
  tenantId               String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Commission             Commission               @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  Policy                 Policy                   @relation(fields: [policyId], references: [id])
  Agent                  User                     @relation(fields: [agentId], references: [id])
  AgentCommissionPayment AgentCommissionPayment[]

  @@index([commissionId])
  @@index([policyId])
  @@index([agentId])
  @@index([tenantId])
  @@index([status])
}

model AgentCommissionPayment {
  id                String          @id @default(cuid())
  agentCommissionId String
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("UF")
  paymentDate       DateTime
  paymentMethod     PaymentMethod
  reference         String?
  bankName          String?
  accountNumber     String?
  notes             String?
  recordedBy        String?
  recordedByName    String?
  createdAt         DateTime        @default(now())
  AgentCommission   AgentCommission @relation(fields: [agentCommissionId], references: [id], onDelete: Cascade)

  @@index([agentCommissionId])
  @@index([paymentDate])
}

model CommunicationAttachment {
  id                 String             @id @default(cuid())
  communicationId    String
  fileName           String
  fileUrl            String
  fileType           String
  fileSize           Int?
  createdAt          DateTime           @default(now())
  QuoteCommunication QuoteCommunication @relation(fields: [communicationId], references: [id], onDelete: Cascade)

  @@index([communicationId])
}

model DocumentSignature {
  id                String                @id @default(cuid())
  documentType      SignatureDocumentType
  documentId        String
  signerName        String
  signerRut         String
  signerEmail       String?
  acceptedTerms     Boolean               @default(false)
  acceptedAt        DateTime?
  ipAddress         String?
  userAgent         String?
  verificationToken String                @unique
  signatureData     String?
  signedDocumentUrl String?
  clientUserId      String?
  tenantId          String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  ClientUser        ClientUser?           @relation(fields: [clientUserId], references: [id])
  Tenant            Tenant                @relation(fields: [tenantId], references: [id])

  @@index([documentType, documentId])
  @@index([tenantId])
  @@index([verificationToken])
}

model Endorsement {
  id            String          @id @default(cuid())
  number        String?
  type          EndorsementType @default(GENERAL_MODIFICATION)
  description   String
  date          DateTime
  policyId      String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  effectiveDate DateTime?
  notes         String?
  premiumChange Decimal?        @db.Decimal(10, 2)
  Policy        Policy          @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model InsuranceCompany {
  id        String   @id @default(cuid())
  name      String
  rut       String?
  contact   String?
  email     String?
  phone     String?
  tenantId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Tenant    Tenant   @relation(fields: [tenantId], references: [id])
  Policy    Policy[]
  Quote     Quote[]

  @@index([tenantId])
}

model MessageAttachment {
  id            String        @id @default(cuid())
  messageId     String
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int?
  createdAt     DateTime      @default(now())
  PortalMessage PortalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

model Plan {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  price       Int      @default(0)
  currency    String   @default("CLP")
  maxUsers    Int      @default(5)
  maxStorage  BigInt   @default(1073741824)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Tenant      Tenant[]
}

model Policy {
  id               String             @id @default(cuid())
  number           String
  company          String
  companyId        String?
  agentId          String?
  type             PolicyType
  status           PolicyStatus       @default(ACTIVE)
  startDate        DateTime
  endDate          DateTime
  premium          Decimal            @db.Decimal(10, 2)
  commission       Decimal            @db.Decimal(10, 2)
  currency         String             @default("UF")
  clientId         String
  tenantId         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  coverages        Json?
  deductibles      Json?
  insuredProperty  Json?
  quoteId          String?            @unique
  Claim            Claim[]
  Commission       Commission[]
  Endorsement      Endorsement[]
  Agent            User?              @relation("AgentPolicies", fields: [agentId], references: [id])
  Client           Client             @relation(fields: [clientId], references: [id])
  InsuranceCompany InsuranceCompany?  @relation(fields: [companyId], references: [id])
  Quote            Quote?             @relation(fields: [quoteId], references: [id])
  Tenant           Tenant             @relation(fields: [tenantId], references: [id])
  PolicyAttachment PolicyAttachment[]
  PolicyItem       PolicyItem[]
  AgentCommission  AgentCommission[]

  @@index([agentId])
  @@index([clientId])
  @@index([quoteId])
  @@index([tenantId])
}

model PolicyAttachment {
  id          String   @id @default(cuid())
  policyId    String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int?
  description String?
  createdAt   DateTime @default(now())
  Policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model PolicyItem {
  id          String   @id @default(cuid())
  policyId    String
  itemNumber  Int
  description String
  value       Decimal  @db.Decimal(12, 2)
  currency    String   @default("UF")
  details     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Policy      Policy   @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
}

model PortalMessage {
  id                String              @id @default(cuid())
  clientUserId      String?
  agentUserId       String?
  agentUserName     String?
  subject           String
  content           String
  policyId          String?
  claimId           String?
  isFromClient      Boolean             @default(true)
  isRead            Boolean             @default(false)
  readAt            DateTime?
  tenantId          String
  createdAt         DateTime            @default(now())
  MessageAttachment MessageAttachment[]
  ClientUser        ClientUser?         @relation(fields: [clientUserId], references: [id])

  @@index([claimId])
  @@index([clientUserId])
  @@index([isRead])
  @@index([policyId])
  @@index([tenantId])
}

model Quote {
  id                   String               @id @default(cuid())
  quoteNumber          String?
  prospectName         String?
  clientId             String?
  agentId              String?
  contractorName       String?
  contractorRut        String?
  contractorEmail      String?
  contractorPhone      String?
  insuredName          String?
  insuredRut           String?
  insuredAddress       String?
  beneficiaryName      String?
  beneficiaryRut       String?
  beneficiaryType      String?
  companyId            String?
  policyType           PolicyType
  insuredProperty      Json?
  coverages            Json
  totalInsuredAmount   Decimal?             @db.Decimal(12, 2)
  totalPremium         Decimal              @db.Decimal(10, 2)
  currency             String               @default("UF")
  deductibles          Json?
  validFrom            DateTime?
  validUntil           DateTime
  policyDuration       Int?
  status               QuoteStatus          @default(DRAFT)
  notes                String?
  internalNotes        String?
  tenantId             String
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  paymentInstallments  Int                  @default(1)
  commissionPercentage Decimal?             @db.Decimal(5, 2)
  Policy               Policy?
  Agent                User?                @relation("AgentQuotes", fields: [agentId], references: [id])
  Client               Client?              @relation(fields: [clientId], references: [id])
  InsuranceCompany     InsuranceCompany?    @relation(fields: [companyId], references: [id])
  Tenant               Tenant               @relation(fields: [tenantId], references: [id])
  QuoteAttachment      QuoteAttachment[]
  QuoteCommunication   QuoteCommunication[]

  @@index([agentId])
  @@index([clientId])
  @@index([companyId])
  @@index([tenantId])
}

model QuoteAttachment {
  id          String   @id @default(cuid())
  quoteId     String
  fileName    String
  fileUrl     String
  fileType    String
  fileSize    Int?
  description String?
  createdAt   DateTime @default(now())
  Quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model QuoteCommunication {
  id                      String                    @id @default(cuid())
  quoteId                 String
  type                    String
  subject                 String?
  content                 String
  contactPerson           String?
  createdAt               DateTime                  @default(now())
  CommunicationAttachment CommunicationAttachment[]
  Quote                   Quote                     @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  rut                String              @unique
  slug               String              @unique
  logoUrl            String?
  plan               String              @default("FREE")
  planId             String?
  customPrice        Int?
  discountType       String?
  discountValue      Int?
  billingDay         Int                 @default(1)
  nextBillingDate    DateTime?
  subscriptionStatus String              @default("TRIAL")
  maxUsers           Int                 @default(5)
  maxStorage         BigInt              @default(1073741824)
  billingEmail       String?
  billingAddress     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  address            String?
  cmfRegistration    String?
  email              String?
  fantasyName        String?
  footerText         String?
  legalName          String?
  phone              String?
  primaryColor       String?             @default("#3b82f6")
  secondaryColor     String?             @default("#1e40af")
  signatureUrl       String?
  website            String?
  AuditLog           AuditLog[]
  BillingRecord      BillingRecord[]
  Claim              Claim[]
  Client             Client[]
  DocumentSignature  DocumentSignature[]
  InsuranceCompany   InsuranceCompany[]
  Policy             Policy[]
  Quote              Quote[]
  Plan               Plan?               @relation(fields: [planId], references: [id])
  User               User[]
}

model User {
  id                          String            @id @default(cuid())
  name                        String?
  email                       String            @unique
  emailVerified               DateTime?
  image                       String?
  password                    String?
  role                        UserRole          @default(AGENT)
  tenantId                    String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  // Agent commission fields
  defaultCommissionPercentage Decimal?          @db.Decimal(5, 2)
  bankName                    String?
  bankAccountNumber           String?
  bankAccountType             String?           // "corriente" | "vista"
  Tenant                      Tenant?           @relation(fields: [tenantId], references: [id])
  AssignedQuotes              Quote[]           @relation("AgentQuotes")
  AssignedPolicies            Policy[]          @relation("AgentPolicies")
  AgentCommission             AgentCommission[]

  @@index([tenantId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  VIEW
  EXPORT
  UPLOAD
  DOWNLOAD
  SIGN
}

enum ClaimStatus {
  REPORTED
  IN_PROCESS
  APPROVED
  REJECTED
  CLOSED
}

enum CommissionStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum EndorsementType {
  GENERAL_MODIFICATION
  RENEWAL
  CANCELLATION
  INCLUSION
  EXCLUSION
}

enum PaymentMethod {
  TRANSFER
  CHECK
  CASH
  CREDIT_CARD
  OTHER
}

enum PolicyStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  RENEWED
}

enum PolicyType {
  GENERAL
  LIFE
  HEALTH
  AUTO
  HOME
  GUARANTEE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SignatureDocumentType {
  QUOTE
  POLICY
  ENDORSEMENT
  CLAIM
}

enum UserRole {
  SUPER_ADMIN
  BROKERAGE_ADMIN
  AGENT
}
